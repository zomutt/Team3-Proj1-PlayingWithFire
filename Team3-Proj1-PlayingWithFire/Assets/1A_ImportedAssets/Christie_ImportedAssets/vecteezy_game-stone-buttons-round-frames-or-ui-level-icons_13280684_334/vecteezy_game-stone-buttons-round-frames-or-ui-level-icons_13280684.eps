   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Game stone buttons, round frames or ui level icons</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Game stone buttons, round frames or ui level icons. cartoon design. Empty badges or banners with green vines, cracks and ropes, Isolated award, reward or bonus graphic elements, vector set for rpg</rdf:li>
    </rdf:Alt>
   </dc:description>
