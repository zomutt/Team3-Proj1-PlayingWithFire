   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Stone game menu boards with vines, rope or leaves.</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Stone game menu boards with vines, rope and leaves. Tablets, buttons, cartoon interface plaques, frames and arrows of rocky texture. Ui or gui design elements. Isolated user panel keys, Vector set</rdf:li>
    </rdf:Alt>
   </dc:description>
